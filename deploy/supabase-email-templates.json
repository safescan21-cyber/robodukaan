 "mailer_templates_confirmation_content": "<div style=\"font-family:Segoe UI,Arial,sans-serif;background:#f1f5f9;padding:32px 12px\">\n<div style=\"max-width:480px;margin:0 auto;background:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0\">\n<div style=\"background:#14306f;padding:18px 24px;font-size:22px;font-weight:800;color:#ffffff\">PCB<span style=\"color:#f97316\">Dukaan</span></div>\n<div style=\"padding:28px 24px;color:#0f172a\">\n<h1 style=\"margin:0 0 12px;font-size:20px\">Confirm your email</h1>\n<p style=\"margin:0 0 20px;font-size:15px;line-height:1.5;color:#334155\">Welcome to PCBDukaan! Enter this code on the website to finish creating your account:</p>\n<div style=\"font-size:34px;font-weight:800;letter-spacing:10px;text-align:center;background:#eef4ff;color:#14306f;border-radius:8px;padding:16px 0\">{{ .Token }}</div>\n<p style=\"margin:16px 0 0;font-size:13px;color:#64748b\">This code expires in 1 hour. If you didn't ask for it, you can ignore this email.</p>\n\n</div></div>\n<p style=\"text-align:center;font-size:12px;color:#94a3b8;margin-top:16px\">PCBDukaan \u00b7 pcbdukaan.com</p></div>",
 "mailer_subjects_magic_link": "{{ .Token }} is your PCBDukaan login code",
